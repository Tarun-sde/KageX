# Local development only. Copy to .env in the repository root.
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# These credentials are disposable local examples, never production credentials.
POSTGRES_USER=kagex
POSTGRES_PASSWORD=kagex_dev_only
POSTGRES_DB=kagex
DATABASE_URL=postgresql+psycopg://kagex:kagex_dev_only@localhost:5432/kagex
REDIS_URL=redis://localhost:6379/0
# Empty values use REDIS_URL; Compose sets container-specific URLs.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Public browser configuration; never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000
