# Local development only. Copy to .env in the repository root.
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# These credentials are disposable local examples, never production credentials.
POSTGRES_USER=kagex
POSTGRES_PASSWORD=kagex_dev_only
POSTGRES_DB=kagex
DATABASE_URL=postgresql+psycopg://kagex:kagex_dev_only@localhost:5432/kagex
REDIS_URL=redis://localhost:6379/0
# Empty values use REDIS_URL; Compose sets container-specific URLs.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Public browser configuration; never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000

# HttpOnly server sessions; production requires HTTPS and APP_ENV=production.
SESSION_TTL_SECONDS=3600
# Native default: <repository>/.data/sources; override with a dedicated absolute path.
# Compose uses its private source_data volume at /app/storage.
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=100
MAX_ARCHIVE_FILES=2000
MAX_FILE_SIZE_MB=10
MAX_COMPRESSION_RATIO=100
INGESTION_TIMEOUT_SECONDS=30
# Static analysis limits; uploaded source is only parsed in the worker.
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_QUEUE_TIMEOUT_SECONDS=600
ANALYZER_TIMEOUT_SECONDS=45
MAX_ANALYSIS_FILE_BYTES=524288
MAX_ANALYSIS_ENTITIES=10000
MAX_ANALYZER_OUTPUT_BYTES=8388608
# Tests create/drop isolated schemas in this PostgreSQL database.
TEST_DATABASE_URL=postgresql+psycopg://kagex:kagex_dev_only@localhost:5432/kagex
